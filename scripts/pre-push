#!/usr/bin/env sh
# Git pre-push hook: 推送前强制执行敏感数据扫描与拦截

echo "🔍 [pre-push] 正在扫描待推送代码中的敏感信息与个人隐私..."

node scripts/sanitize-secrets.mjs --check
RESULT=$?

if [ $RESULT -ne 0 ]; then
  echo "❌ [pre-push] 检测到未脱敏的敏感信息，推送已被安全拦截！"
  echo "👉 请运行: pnpm sanitize 自动清除敏感信息并用示例替代，确认测试通过后重新提交。"
  exit 1
fi

echo "✅ [pre-push] 敏感信息检查通过，允许推送。"
exit 0
